SWAPPY_HOST=localhost
SWAPPY_PORT=8080
SWAPPY_DB_PORT=5433
SWAPPY_DATABASE_URL=postgres://swappy:swappy@localhost:5433/swappy?sslmode=disable
SWAPPY_STORAGE_DIR=data/images
# Only for local testing: lets the app log in as any display name without a password.
SWAPPY_DEV_LOGIN=true
# Required whenever SWAPPY_DEV_LOGIN is not true.
SWAPPY_TOKEN_SECRET=
